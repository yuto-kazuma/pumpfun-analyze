# Required: Helius API key (https://helius.dev)
HELIUS_API_KEY=your_helius_api_key_here

# Optional: override RPC URL (defaults to Helius mainnet RPC)
# RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key_here

# Default target wallet (can also pass --wallet on CLI)
TARGET_WALLET=DWHEZ8JnfGtud25Gjhn3MndpTMshNEd12WMu2ciCa7ri

# SQLite database path (relative to project root or absolute)
DATABASE_PATH=data/pumpfun_intel.db

# Disk cache for raw API batches
CACHE_DIR=data/cache

# Rate limiting (requests per second)
RPC_RPS=8
HELIUS_RPS=5

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
